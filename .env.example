# Copy this file to .env and fill in your credentials for local testing.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.lafx8yo.mongodb.net/?retryWrites=true&w=majority
# Chạy thử ở máy: dùng bim_preview, KHÔNG dùng bim (đó là dữ liệu thật).
MONGODB_DB=bim_preview
MONGODB_COLLECTION=bim_app
# Collection chứa metadata file đính kèm. Bỏ trống → mặc định "bim_files".
# Script scripts/don-file-mo-coi.mjs đọc đúng biến này, nên đặt sai ở đây
# sẽ làm script nhìn thấy một collection rỗng.
MONGODB_FILES_COLLECTION=bim_files

# Để trống cả hai → không khoá gì (mọi request là quyền quản trị).
EDIT_KEY=
ADMIN_KEY=

# ---- Amazon S3: nơi lưu file đính kèm (từ 09/2026) ----
# Lấy ở AWS Console → IAM → Users → Security credentials → Create access key.
# KHÔNG bao giờ ghi giá trị thật vào file này — đây là file mẫu, có trong git.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# PHẢI khớp tuyệt đối với vùng của bucket. SigV4 nhét vùng vào chữ ký, nên sai
# vùng là 403 ở mọi request — và thông báo lỗi của S3 không hề nhắc tới vùng.
S3_REGION=ap-southeast-1
# production: bucket thật · preview/development: bucket thử nghiệm riêng
S3_BUCKET=
