# Copy this file to .env and fill in your MongoDB credentials for local testing.
MONGODB_URI=mongodb+srv://ngothuytq98_db_user:<password>@cluster0.lafx8yo.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bim
MONGODB_COLLECTION=bim_app
# Collection chứa metadata file đính kèm. Bỏ trống → mặc định "bim_files".
# Script scripts/don-file-mo-coi.mjs đọc đúng biến này, nên đặt sai ở đây
# sẽ làm script nhìn thấy một collection rỗng.
MONGODB_FILES_COLLECTION=bim_files

# ---- Cloudflare R2: nơi lưu file đính kèm (từ 09/2026) ----
# Lấy ở Cloudflare Dashboard → R2 → Manage R2 API Tokens.
# KHÔNG bao giờ ghi giá trị thật vào file này — đây là file mẫu, có trong git.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# production: bim-files · preview/development: bim-files-preview
R2_BUCKET=
