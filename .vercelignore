# Bí mật — đặt biến môi trường trong Vercel Dashboard, KHÔNG đẩy file .env lên
.env
.env.*
!.env.example

# Chỉ dùng khi chạy local (máy chủ LAN) — Vercel dùng MongoDB thay thế
serve.cjs
data.json

# MỌI file .bat, không liệt kê từng cái. Trước đây chỉ chặn đúng start-server.bat,
# nên dong-bo.bat (09/2026) lọt qua và suýt mở công khai qua https://…/dong-bo.bat.
# File .bat là công cụ chạy ở máy, không bao giờ là thứ để phục vụ trên web — và
# chúng hay chứa đường dẫn nội bộ, tên máy chủ, tên ổ mạng.
*.bat

# Tài liệu — KHÔNG deploy. Vercel phục vụ mọi file tĩnh, nên file .md nằm trong
# thư mục gốc sẽ mở được công khai qua https://…/CLAUDE.md và tương tự. Chúng
# chứa kiến trúc, tên biến môi trường, tên user MongoDB — không có lý do gì để
# lộ ra ngoài. Ứng dụng không đọc file .md nào lúc chạy.
*.md
docs
plans

# Script quản trị — chạy ở máy, tuyệt đối không nằm trong bundle production
# (don-file-mo-coi.mjs có quyền xoá hàng loạt object trên R2)
scripts
scratch

# Rác
node_modules
.DS_Store
npm-debug.log*
.claude
data-files
