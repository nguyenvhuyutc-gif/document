# ============================================================
#  Mau cau hinh cho script dong bo NAS - CHEP THANH .env.dong-bo roi dien
#
#      copy scripts\.env.dong-bo.example scripts\.env.dong-bo
#
#  File .env.dong-bo KHONG BAO GIO commit (da bi .gitignore chan).
#  Dat quyen NTFS cho dung tai khoan duoc chay script - trong file co mat khau.
# ============================================================

# Mat khau quyen SUA cua moi truong production. BAT BUOC.
EDIT_KEY=

# Mat khau quyen QUAN TRI. TUY CHON - de trong la binh thuong.
#
# Chi mo dung MOT viec: khi mot file trong thu muc va tren web cung ten nhung
# khac noi dung, script hoi ban co day ban trong thu muc len khong; dong y thi
# ban cu duoc chuyen vao THUNG RAC (giu 30 ngay, khoi phuc duoc, file tren kho
# luu tru khong bi xoa). De trong thi tinh nang do tat, script chi bao ra muc
# "CAN BAN QUYET" nhu truoc - khong hong gi khac.
#
# Script KHONG BAO GIO xoa vinh vien, va khong dung khoa nay vao viec gi khac.
# Nhung day van la mat khau manh nhat cua he thong: ai doc duoc file nay la mo
# duoc ca thung rac. Chi dien tren may CUA BAN, dung dien tren may dung chung.
ADMIN_KEY=

# Goc cua web, khong co dau / o cuoi.
BASE_URL=https://bvtc.vcijsc.com

# Thu muc goc tren NAS. Dung mot trong hai dang:
#   UNC     THU_MUC_GOC=\\nas\duan\SBGB\04.WEB
#   O map   THU_MUC_GOC=Z:\SBGB\04.WEB
# UNC ben hon: o map phu thuoc phien dang nhap, chay theo lich la mat o.
# Khong dat dau nhay quanh gia tri, khong de dau \ o cuoi.
#
# TRO VAO MOT THU MUC CON RIENG (vd 04.WEB), DUNG tro thang vao thu muc du an.
# Cay thu muc o day do MAY sinh ra tu bang tren web va duoc dung lai moi lan chay;
# cay cu cua cong ty la do NGUOI sap. De lan nhau thi kho nhin ra cai nao la cai nao,
# va moi lan bang doi ten hang muc lai co mot thu muc la moc len giua cay cu.
# Script khong bao gio dung toi thu muc khong co dau .bim-id, nen tro thang vao thu
# muc du an cung KHONG hong gi - chi la roi ram.
#
# Doi thu muc goc ve sau rat re: chuyen ca cay sang cho moi roi sua dong nay la xong.
# Script nhan ra cay cu bang dau .bim-id chu khong bang duong dan, nen no KHONG dung
# lai tu dau va KHONG tai lai file nao.
THU_MUC_GOC=\\nas\duan\SBGB\04.WEB

# Ma ke hoach can dong bo. Lay o thanh dia chi khi mo ke hoach tren web
# (?plan=...). KHONG duoc de trong - script se dung va bao thieu bien.
# Ke hoach mac dinh cu (chua tach ke hoach) thi ghi dung chu: data
PLAN_ID=
